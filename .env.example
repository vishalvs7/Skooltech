# ==============================================================================
# Skooltech — Environment Configuration Placeholders
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database (Step 2)
# ------------------------------------------------------------------------------
# Connection pooling URL (used by Prisma Client in production/serverless)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct database connection URL (used by Prisma for migrations)
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# Supabase Storage & Project Keys (Step 8 & 9)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# Multi-Tenant JWT Session Secret (Step 3)
# ------------------------------------------------------------------------------
JWT_SECRET="replace-with-a-secure-random-32-character-secret-in-production"

# ------------------------------------------------------------------------------
# Transactional Email: Brevo / Sendinblue (Step 9 Placeholder)
# ------------------------------------------------------------------------------
BREVO_API_KEY="xkeysib-placeholder-api-key"
BREVO_SENDER_EMAIL="notifications@skooltech.in"
BREVO_SENDER_NAME="Skooltech Alerts"

# ------------------------------------------------------------------------------
# Payment Gateway: BYOG Razorpay / Cashfree (Step 9 Placeholder)
# ------------------------------------------------------------------------------
# Note: School-specific keys are stored in the School tenant table.
# Global platform fallback / test key for development mode:
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
